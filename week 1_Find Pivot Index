class Solution {
    public int pivotIndex(int[] nums) {
        int totalSum = 0;

        // Step 1: Calculate the total sum
        for (int num : nums) {
            totalSum += num;
        }

        int leftSum = 0;

        // Step 2: Check each index
        for (int i = 0; i < nums.length; i++) {

            // Right sum = total - left - current element
            int rightSum = totalSum - leftSum - nums[i];

            if (leftSum == rightSum) {
                return i;  // Leftmost pivot index
            }

            // Step 3: Add current element to left sum
            leftSum += nums[i];
        }

        return -1;
    }
}
